              "host": ["{{baseUrl}}"],
              "path": ["api", "industry-modules", "CONSTRUCTION", "roles"]
            },
            "description": "Returns the RoleType vocabulary applicable to this module: SHE_OFFICER, SITE_SUPERVISOR, GENERAL_WORKER, CONTRACTOR, MANAGEMENT."
          }
        },
        {
          "name": "List responsibilities for a role",
          "request": {
