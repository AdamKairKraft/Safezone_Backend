          "name": "List industry modules",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/industry-modules", "host": ["{{baseUrl}}"], "path": ["api", "industry-modules"] }
          }
        },
        {
          "name": "List report types for a module",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/industry-modules/CONSTRUCTION/report-types",
              "host": ["{{baseUrl}}"],
              "path": ["api", "industry-modules", "CONSTRUCTION", "report-types"]
            }
          }
        },
