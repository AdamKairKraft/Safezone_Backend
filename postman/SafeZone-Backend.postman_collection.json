              "path": ["api", "industry-modules", "CONSTRUCTION", "roles", "SITE_SUPERVISOR", "responsibilities"]
            }
          }
        },
        {
          "name": "List required reports for a role",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/industry-modules/CONSTRUCTION/roles/SITE_SUPERVISOR/required-reports",
              "host": ["{{baseUrl}}"],
